# Server-only Playwright protocol endpoint (not a CDP endpoint).
# Remote server must run Playwright 1.64.1 with Chromium installed.
# Configure only when remote Playwright support is enabled by the capture runner.
WEBABLE_PLAYWRIGHT_WS_ENDPOINT=wss://your-browser-service/playwright-endpoint

# Optional AI analysis. Keep real keys in your server environment or an ignored .env file.
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
